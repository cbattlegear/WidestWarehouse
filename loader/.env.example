# SQL Server connection. For SQL Server on your Docker host use host.docker.internal,1433.
DW_SERVER=host.docker.internal,1433
DW_DATABASE=WidestWarehouse
DW_USER=warehouse_loader
DW_PASSWORD=change-me
DW_ENCRYPT=yes
DW_TRUST_SERVER_CERTIFICATE=yes
DW_DRIVER=ODBC Driver 18 for SQL Server

# Five-field cron expressions, evaluated in UTC by APScheduler.
PIPELINE_CRON=*/15 * * * *
DQ_CRON=0 * * * *
HOUSEKEEPING_CRON=0 2 * * *
ANALYTICS_CRON=*/5 * * * *

# Randomized read-only BI workload. Results are never stored; timings go to the log.
ANALYTICS_QUERIES_PER_RUN=10
ANALYTICS_QUERY_TIMEOUT_SECONDS=60
# Set an integer to make the generated query set reproducible. Leave blank for random.
# ANALYTICS_SEED=42

BATCH_ROWS_PER_CYCLE=1000
LANDING_DIR=/data/landing
RUN_ON_STARTUP=true
LOG_LEVEL=INFO
RETENTION_DAYS=14
CONNECTION_TIMEOUT_SECONDS=10
